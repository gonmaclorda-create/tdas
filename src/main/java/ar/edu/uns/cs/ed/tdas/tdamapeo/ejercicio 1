public Dictionary<K,V> acomodar(Dictionary<K,V> d){
    Map<K,V> aux = new MapeoConLista<>();
    Dictionary<K,V> dRes = new DiccionarioConLista<>();
    for(Entry<K,V> d1: d.entries())
        aux.put(d1.getKey(),d1.getValue())
    for(Entry<K,V> m1: aux.entries())
        dRes.insert(m1.getKey(),m1.getValue());
    return dRes;
}

public Map<K,V> incisioD(PositionList<Character> j){
    Map<K,V> m = new MApeoConLista<>();
    for(Position<Character> p : j.positions()){
        Character c =p.element();
        if(m.getValue(c)==null)
            m.put(c,1);
        else
            m.put(c,m.getvalue(c)+1);
    }
    return m;
}